#!/bin/bash
# Update the clean upstream checkout, then reclaim the personal bar.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
UPSTREAM_REPO="${OMACOSY_UPSTREAM_REPO:-$HOME/.local/share/omacosy}"
UPDATER="$UPSTREAM_REPO/bin/omacosy-update"
ACTIVATE="$REPO/personal-bar/activate"
UID_N="$(id -u)"

if [ ! -x "$UPDATER" ]; then
  echo "personal-bar: upstream updater is missing at $UPDATER" >&2
  exit 1
fi

# Avoid two bars during the part of install.sh that starts upstream's bar.
launchctl bootout "gui/$UID_N/com.omacosy.personal-bar" 2>/dev/null || true

update_status=0
"$UPDATER" "$@" || update_status=$?
activation_status=0
"$ACTIVATE" || activation_status=$?

if [ "$update_status" -ne 0 ]; then
  echo "personal-bar: upstream update failed; personal activation was still attempted" >&2
  exit "$update_status"
fi
if [ "$activation_status" -ne 0 ]; then
  echo "personal-bar: upstream updated, but personal activation failed" >&2
  exit "$activation_status"
fi
